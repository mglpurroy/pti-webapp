    },
    {
      "name": "Climate & Environment",
      "color": "#16a085"
    },
    {
      "name": "Fragility & Operations",
      "color": "#c0392b"
    }
  ],
  "scenarios": [
    {
      "id": "core",
      "label": "Core PTI",
      "description": "Multi-sector need — poverty, services and human development",
      "weights": {
        "poverty_headcount": 25,
        "travel_time_health": 15,
        "electricity_access": 15,
        "net_enrolment": 15,
        "stunting_rate": 15,
        "food_insecurity_phase": 15
      }
    },
    {
      "id": "social",
      "label": "Social Development PTI",
      "description": "Poverty, education and nutrition",
      "weights": {
        "poverty_headcount": 40,
        "net_enrolment": 30,
        "stunting_rate": 30
      }
    },
    {
      "id": "energy",
      "label": "Energy PTI",
      "description": "Unserved population with productive potential",
      "weights": {
        "electricity_access": 50,
        "population_density": 30,
        "poverty_headcount": 20
      }
    },
    {
      "id": "nutrition",
      "label": "Nutrition PTI",
      "description": "Food insecurity, stunting and health access",
      "weights": {
        "food_insecurity_phase": 40,
        "stunting_rate": 35,
        "travel_time_health": 25
      }
    },
    {
      "id": "operable",
      "label": "Core PTI + operational access",
      "description": "Core need, discounted where field access is restricted (a spatial political-economy constraint)",
      "weights": {
        "poverty_headcount": 20,
        "travel_time_health": 15,
        "electricity_access": 10,
        "net_enrolment": 10,
        "stunting_rate": 10,
        "food_insecurity_phase": 10,
        "operational_access": 25
      }
    }
