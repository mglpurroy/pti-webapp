      "weights": {
        "poverty_headcount": 2,
        "travel_time_health": 1,
        "electricity_access": -1,
        "net_enrolment": -1,
        "stunting_rate": 1,
        "food_insecurity_phase": 1,
        "restricted_access": -2
      }
    }
